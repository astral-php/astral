{
    "name": "astral-php/astral",
    "description": "Astral MVC — Framework PHP 8.1+ minimaliste, moderne et orienté objet",
    "type": "project",
    "version": "1.2.3",
    "license": "MIT",
    "keywords": ["php", "mvc", "framework", "microframework", "di", "psr"],
    "homepage": "https://github.com/astral-php/astral",
    "support": {
        "source": "https://github.com/astral-php/astral",
        "issues": "https://github.com/astral-php/astral/issues"
    },
    "require": {
        "php": "^8.1",
        "astral-php/astral-core": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit tests/"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
